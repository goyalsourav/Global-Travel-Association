# Template only — copy to .env and fill in real values THERE.
# The app reads .env (gitignored). This file gets committed, so never put
# real secrets in it.

# Vercel Blob read-write token (Vercel dashboard -> Storage -> Blob -> BLOB_READ_WRITE_TOKEN)
# All data (events, members, site content, etc.) is stored as JSON files in
# Vercel Blob — no database required for this low-write landing page.
BLOB_READ_WRITE_TOKEN=

# Initial password for the /admin panel. Once the password is changed from the
# admin Settings tab it is stored (hashed) in the blob store and this value is
# only used as a fallback until then.
ADMIN_PASSWORD=

# --- Google Sheets integration ---
# A Google Apps Script inside your Sheet polls GET /api/applications every few
# minutes. Set any strong random string here and copy it into the script.
#
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
APPLICATIONS_API_KEY=
